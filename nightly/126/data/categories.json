y the complete light-mode design on their own, because·\n         Outlook desktop ignores this entire block. */·\n      body { margin:0; padding:0; width:100% !important; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }·\n      table { border-collapse:collapse !important; mso-table-lspace:0pt; mso-table-rspace:0pt; }·\n      img { border:0; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }·\n      a { text-decoration:none; }·\n      /* iOS auto-links dates/addresses/phones in its own blue; force ours. */·\n      a[x-apple-data-detectors] { color:inherit !important; text-decoration:none !important; font-size:inherit !important; font-family:inherit !important; font-weight:inherit !important; line-height:inherit !important; }·\n      .e-body { margin:0; padding:0; width:100% !important; }·····\n      @media only screen and (max-width:600px) {·\n        .e-container { width:100% !important; max-width:100% !important; }·\n        .e-pad { padding-left:20px !important; padding-right:20px !important; }·\n        .e-pad-y { padding-top:24px !important; padding-bottom:24px !important; }·\n        .e-h1 { font-size:22px !important; line-height:28px !important; }·\n        .e-h1-serif { font-size:24px !important; line-height:30px !important; }·\n        .e-h2 { font-size:18px !important; line-height:24px !important; }·\n        .e-total { font-size:22px !important; line-height:28px !important; }·\n        .e-num-hero { font-size:28px !important; line-height:32px !important; }·\n        /* box-sizing:border-box so the card's own padding + border stay INSIDE·\n           width:100% instead of adding ~42px and overflowing the viewport by·\n           10px. Honored by Gmail webmail, Apple/iOS Mail and every modern client;·\n           Outlook desktop is always >=600px so it never reaches this breakpoint. */·\n        .e-stack { display:block !important; width:100% !important; max-width:100% !important; box-sizing:border-box !important; }·\n        /*
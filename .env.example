# RestauNax Automation — environment template.
#
# Copy to .env and fill in. .env is gitignored; NEVER commit real credentials.
# In CI these come from the GitHub `qa` environment (secrets) + repo variables —
# see CI_PLAN.md. A fresh checkout with only some of these set will SILENTLY
# SKIP the tests that need the rest (they self-skip via env guards), so a run
# can look green while covering half the suite. Fill everything for a full run.
#
# SAFETY: the URLs below must point at QA or localhost. The suite hard-deletes
# data via an admin token in teardown; utils/targetGuard.ts refuses to run
# against any non-allowlisted host (prod is blocked). See utils/targetGuard.ts.

# ── Target URLs ──────────────────────────────────────────────────────────────
# Dashboard (owner/admin app). Default: https://app.qa.restaunax.com
FRONTEND_URL=https://app.qa.restaunax.com
# Backend API. Default: https://api.qa.restaunax.com
BACKEND_URL=https://api.qa.restaunax.com
# Customer ordering site (Template Wind). Default: https://wind.restaunax.com
# (NOT qa.restaunax.com — that is the QA marketing site, see utils/targetGuard.ts)
TEMPLATE_WIND_URL=https://wind.restaunax.com

# ── Accounts ─────────────────────────────────────────────────────────────────
# OWNER must own the seed restaurant (SEED_RESTAURANT_ID).
OWNER_EMAIL=
OWNER_PASSWORD=
# ADMIN is required for teardown sweeps + hard menu-item deletes.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# EMPLOYEE unlocks the employee suite (skipped when unset).
EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD=

# ── Seed data ────────────────────────────────────────────────────────────────
# The restaurant the suite pins all state to (owned by OWNER). If unset, the
# suite falls back to the owner's first restaurant (with a warning).
SEED_RESTAURANT_ID=
# Optional human-readable fallback used to resolve the seed restaurant by name.
SEED_RESTAURANT_NAME=
# Restaurant id the customer-site (Template Wind) specs order against.
TEMPLATE_WIND_RESTAURANT_ID=

# ── Email checks (Mailpit) ───────────────────────────────────────────────────
# QA sends all mail to a self-hosted Mailpit inbox (backend
# EMAIL_SANDBOX_PROVIDER=mailpit). Unlocks the email-journey tests (TC-123 et
# al.) — they skip if MAILPIT_BASE_URL is unset. Humans can read the same inbox
# in a browser at the URL below (same credentials).
MAILPIT_BASE_URL=https://mail.qa.restaunax.com
MAILPIT_UI_USER=qa
MAILPIT_UI_PASSWORD=
# Domain used for generated test recipient addresses.
TEST_EMAIL_DOMAIN=demomailtrap.co

# ── Email-sending tests ──────────────────────────────────────────────────────
# Tests that send real mail are tagged @email (@demo = demo subset). Mailpit is
# self-hosted and unmetered, so they run in the default suite and the nightly —
# the tags are just selectors for targeted runs (`npm run test:email` /
# `test:demo`). No SEND_* or INCLUDE_EMAIL_TESTS toggles — see TEST_PLAN →
# "Test execution strategy".

# ── CI ───────────────────────────────────────────────────────────────────────
# Set automatically by GitHub Actions. When "true": retries=1, workers=2,
# forbidOnly. Leave unset locally.
# CI=

# ── App URLs ──────────────────────────────────────────────────────────────────
# Frontend (React dashboard — where /demo, /sign-in, /admin live)
FRONTEND_URL=https://app.qa.restaunax.com
# Local dev: FRONTEND_URL=http://localhost:5173

# Backend API (used by apiHelper for direct HTTP calls during setup/teardown)
BACKEND_URL=https://api.qa.restaunax.com
# Local dev: BACKEND_URL=http://localhost:3001

# ── Owner credentials ─────────────────────────────────────────────────────────
# A real restaurant-owner account used to seed test data and run owner-flow tests
OWNER_EMAIL=your_owner_email_here
OWNER_PASSWORD=your_owner_password_here

# ── Admin credentials ─────────────────────────────────────────────────────────
# A platform-admin account used for admin-flow tests and teardown cleanup
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here

# ── Mailtrap Email Testing API ────────────────────────────────────────────────
# Use an Email Testing token (Mailtrap → Email Testing → Inbox → API Tokens)
# NOT a Sending API token — those return 403 on inbox endpoints
MAILTRAP_API_TOKEN=your_mailtrap_email_testing_token_here
MAILTRAP_INBOX_ID=your_mailtrap_inbox_id_here

# ── Test email domain ─────────────────────────────────────────────────────────
# UUID suffix is appended per run to avoid collisions across parallel or repeated runs
TEST_EMAIL_DOMAIN=restaunax-test.com

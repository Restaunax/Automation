{
  "name": "restaunax-automation",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end automation tests for Restaunax using Playwright + Allure",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:ci": "CI=true playwright test",
    "report": "allure generate allure-results -o allure-report --clean && allure open allure-report",
    "report:html": "playwright show-report",
    "clean": "rm -rf allure-results allure-report test-results playwright-report results.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@playwright/test": "^1.50.0",
    "allure-js-commons": "^3.0.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "allure-commandline": "^2.30.0",
    "eslint": "^10.5.0",
    "eslint-plugin-playwright": "^2.10.4",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "tsx": "4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}

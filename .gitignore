# No trailing slash: also match a node_modules SYMLINK (worktrees link the
# main checkout's), which `node_modules/` misses since a symlink isn't a dir.
node_modules
allure-results/
allure-report/
playwright-report/
test-results/
dist/
graphify-out

# JSON reporter output consumed by scripts/publish-results.ts
results.json

# Shared state written by globalSetup between test runs
*.tmp.json

# Local environment — never commit credentials
.env

# OS / editor cruft
.DS_Store

# Personal Claude skills (not part of the test suite)
.claude/skills/
.vscode
# playwright-cli exploration artefacts + local scratch scripts
.playwright-cli/
scripts/tmp-scratch/
